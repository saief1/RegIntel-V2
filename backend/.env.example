NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://regintel:regintel@localhost:5432/regintel?schema=public
DIRECT_URL=postgresql://regintel:regintel@localhost:5432/regintel?schema=public
REDIS_URL=redis://localhost:6379
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
USE_REAL_POLICIES=false
USE_REAL_TASKS=false
USE_REAL_CASES=false
USE_REAL_KNOWLEDGE=false
USE_REAL_REPORTS=false
USE_REAL_NOTIFICATIONS=false
USE_REAL_STORAGE=false
USE_REAL_EMAIL=false
USE_REAL_AUDIT=false
USE_REAL_SEARCH=false
USE_REAL_AI=false
USE_RAG=false
USE_VECTOR_SEARCH=false
AI_PROVIDER=mock
VECTOR_STORE=pgvector
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_HISTORY_TOKEN_BUDGET=2500
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
