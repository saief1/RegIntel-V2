  confidence     Float?
  latencyMs      Int?         @map("latency_ms")
  chunkCount     Int          @default(0) @map("chunk_count")
  tokenUsage     Json?        @map("token_usage")
  answer         String?
  reasoningSummary String?    @map("reasoning_summary")
  lowConfidence  Boolean      @default(false) @map("low_confidence")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session        SearchSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  results        RagResult[]
  citations      Citation[]
  retrievalLogs  RetrievalLog[]

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([sessionId])
  @@map("rag_queries")
}

model RagResult {
  id             String   @id @default(uuid()) @db.Uuid
  queryId        String   @map("query_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  chunkId        String?  @map("chunk_id") @db.Uuid
  entityType     EmbeddingEntityType @map("entity_type")
  entityId       String   @map("entity_id")
  title          String   @default("")
  contentPreview String   @map("content_preview")
  score          Float
  rank           Int
  contentVersion Int?     @map("content_version")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  query          RagQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId, rank])
  @@index([organizationId, entityType])
  @@map("rag_results")
}

model RetrievalLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  queryId        String?  @map("query_id") @db.Uuid
  operation      String
  useVector      Boolean  @default(false) @map("use_vector")
  useHybrid      Boolean  @default(true) @map("use_hybrid")
  topK           Int      @default(8)
  hitCount       Int      @default(0) @map("hit_count")
  latencyMs      Int?     @map("latency_ms")
  filters        Json?
  scores         Json?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  query          RagQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([queryId])
  @@map("retrieval_logs")
}

model Citation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  queryId        String?  @map("query_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  marker         String
  kind           String
  title          String
  subtitle       String?
  href           String?
  snippet        String?
  entityType     EmbeddingEntityType? @map("entity_type")
  entityId       String?  @map("entity_id")
  chunkId        String?  @map("chunk_id") @db.Uuid
  chunkIndex     Int?     @map("chunk_index")
  highlightStart Int?     @map("highlight_start")
  highlightEnd   Int?     @map("highlight_end")
  contentVersion Int?     @map("content_version")
  score          Float?
  confidence     Float?
  evidenceChain  Json?    @map("evidence_chain")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  query          RagQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([queryId])
  @@index([messageId])
  @@map("citations")
}

model KnowledgeRelationship {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  fromEntityType EmbeddingEntityType   @map("from_entity_type")
  fromEntityId   String                @map("from_entity_id")
  toEntityType   EmbeddingEntityType   @map("to_entity_type")
  toEntityId     String                @map("to_entity_id")
  relationType   KnowledgeRelationType @map("relation_type")
  weight         Float                 @default(1)
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromEntityType, fromEntityId, toEntityType, toEntityId, relationType])
  @@index([organizationId, fromEntityType, fromEntityId])
  @@index([organizationId, toEntityType, toEntityId])
  @@map("knowledge_relationships")
}

model RetrievalMetric {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  queryCount     Int      @default(0) @map("query_count")
  avgLatencyMs   Float    @default(0) @map("avg_latency_ms")
  avgConfidence  Float    @default(0) @map("avg_confidence")
  avgHitCount    Float    @default(0) @map("avg_hit_count")
  lowConfidenceCount Int  @default(0) @map("low_confidence_count")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, periodStart])
  @@map("retrieval_metrics")
}
