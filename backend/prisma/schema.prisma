generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct Postgres URL for migrations when DATABASE_URL uses a pooler.
  directUrl = env("DIRECT_URL")
}

/// Legacy B1 membership labels retained for compatibility; prefer `appRole`.
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// Database-driven RBAC role keys (B007 + v2.2.1 aliases).
/// Display aliases: Owner/Administrator→ORG_ADMIN, Reviewer/Employee/Guest added.
enum AppRole {
  SUPER_ADMIN
  ORG_ADMIN
  COMPLIANCE_OFFICER
  MANAGER
  ANALYST
  VIEWER
  REVIEWER
  EMPLOYEE
  GUEST
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LoginAttemptResult {
  SUCCESS
  FAILURE
  MFA_REQUIRED
  MFA_FAILURE
  BLOCKED
}

enum SsoProviderType {
  OIDC
  SAML
}

enum PermissionScope {
  ORGANIZATION
  TEAM
  RESOURCE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ScimSyncState {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

// ─── Milestone B3 domain enums ───────────────────────────────────────────────

enum PolicyLifecycleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum TaskLifecycleStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
}

enum CaseLifecycleStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  COMPLETED
  CLOSED
}

enum NotificationKind {
  DUE
  ASSIGNMENT
  APPROVAL
  MENTION
  POLICY_REVIEW
  SECURITY_ALERT
  AI
  REGULATION
  DIGEST
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  DIGEST
}

enum StorageProviderType {
  LOCAL
  S3
  AZURE
  GCS
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED
}

enum AttachmentOwnerType {
  POLICY
  TASK
  CASE
  KNOWLEDGE
  REPORT
  GENERAL
}

// ─── Milestone B4 platform enums ─────────────────────────────────────────────

enum EmailProviderType {
  CONSOLE
  SMTP
  RESEND
  SENDGRID
  SES
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
  DELIVERED
}

enum AuditExportStatus {
  PENDING
  READY
  FAILED
}

enum AuditExportFormat {
  JSON
  CSV
}

enum SearchEntityType {
  POLICY
  KNOWLEDGE
  DOCUMENT
  TASK
  CASE
  REPORT
  COMMENT
  NOTIFICATION
  USER
  ORGANIZATION
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model Organization {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String
  slug              String                   @unique
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  memberships       OrganizationMembership[]
  teams             Team[]
  ssoConfigurations SsoConfiguration[]
  scimConfiguration ScimConfiguration?
  scimGroups        ScimGroup[]
  scimSyncRuns      ScimSyncRun[]
  permissionGrants  PermissionGrant[]
  policies          Policy[]
  documents         KnowledgeDocument[]
  tasks             Task[]
  cases             Case[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  reports           Report[]
  workflows         Workflow[]
  storageObjects    StorageObject[]
  attachments       Attachment[]
  auditEntries      AuditEntry[]
  auditLogs         AuditLog[]
  auditExports      AuditExport[]
  activityEvents    ActivityEvent[]
  emailDeliveries   EmailDelivery[]
  emailTemplates    EmailTemplate[]
  searchDocuments   SearchDocument[]
  tenantLimit       TenantLimit?
  tenantUsage       TenantUsage[]
  featureFlags      FeatureFlag[]
  aiConversations   AiConversation[]
  aiPrompts         AiPrompt[]
  embeddingDocuments EmbeddingDocument[]
  embeddingChunks   EmbeddingChunk[]
  embeddingDocumentVersions EmbeddingDocumentVersion[]
  vectorMetadata    VectorMetadata[]
  aiUsage           AiUsage[]
  aiCosts           AiCost[]
  aiProviderLogs    AiProviderLog[]
  ragQueries        RagQuery[]
  retrievalLogs     RetrievalLog[]
  citations         Citation[]
  knowledgeRelationships KnowledgeRelationship[]
  searchSessions    SearchSession[]
  retrievalMetrics  RetrievalMetric[]
  indexingJobs      IndexingJob[]

  @@map("organizations")
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique
  passwordHash       String                   @map("password_hash")
  name               String
  isSuperAdmin       Boolean                  @default(false) @map("is_super_admin")
  mfaEnabled         Boolean                  @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?                  @map("mfa_secret_encrypted")
  mfaEnrolledAt      DateTime?                @map("mfa_enrolled_at")
  externalId         String?                  @unique @map("external_id")
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  memberships        OrganizationMembership[]
  refreshTokens      RefreshToken[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  teamMemberships    TeamMembership[]
  permissionGrants   PermissionGrant[]
  trustedDevices     TrustedDevice[]
  passwordHistory    PasswordHistory[]
  loginAttempts      LoginAttempt[]
  securityEvents     SecurityEvent[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  assignedTasks      Task[]                   @relation("TaskAssignee")
  createdTasks       Task[]                   @relation("TaskCreator")
  ownedCases         Case[]                   @relation("CaseOwner")
  auditEntries       AuditEntry[]
  auditLogs          AuditLog[]
  activityEvents     ActivityEvent[]
  aiConversations    AiConversation[]
  aiMessages         AiMessage[]
  aiProviderLogs     AiProviderLog[]
  ragQueries         RagQuery[]
  searchSessions     SearchSession[]
  citations          Citation[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// Legacy B1 field — kept in sync with `appRole` by application code.
  role           MembershipRole   @default(MEMBER)
  appRole        AppRole          @default(VIEWER) @map("app_role")
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([appRole])
  @@map("organization_memberships")
}

model RefreshToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  tokenHash       String         @map("token_hash")
  familyId        String         @map("family_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  replacedById    String?        @map("replaced_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  lastActiveAt    DateTime       @default(now()) @map("last_active_at")
  deviceLabel     String?        @map("device_label")
  userAgent       String?        @map("user_agent")
  ipAddress       String?        @map("ip_address")
  trustedDeviceId String?        @map("trusted_device_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedDevice   TrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@index([trustedDeviceId])
  @@map("refresh_tokens")
}

/// MFA "remember this browser" trusted device (v2.2.1).
model TrustedDevice {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  tokenHash       String         @map("token_hash")
  fingerprintHash String?        @map("fingerprint_hash")
  name            String
  userAgent       String?        @map("user_agent")
  ipAddress       String?        @map("ip_address")
  trustedAt       DateTime       @default(now()) @map("trusted_at")
  lastSeenAt      DateTime       @default(now()) @map("last_seen_at")
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([tokenHash])
  @@map("trusted_devices")
}

/// Queryable security / audit trail for Security Center (v2.2.1). Full immutable store remains B024.
model SecurityEvent {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  organizationId String?               @map("organization_id") @db.Uuid
  action         String
  resource       String
  severity       SecurityEventSeverity @default(LOW)
  detail         String?
  ipAddress      String?               @map("ip_address")
  userAgent      String?               @map("user_agent")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@map("security_events")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginAttempt {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String?            @map("user_id") @db.Uuid
  email     String
  result    LoginAttemptResult
  reason    String?
  ipAddress String?            @map("ip_address")
  userAgent String?            @map("user_agent")
  createdAt DateTime           @default(now()) @map("created_at")
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([result, createdAt])
  @@map("login_attempts")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         AppRole          @unique
  name        String
  description String
  isSystem    Boolean          @default(true) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  name        String
  description String
  category    String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  roles       RolePermission[]
  grants      PermissionGrant[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model SsoConfiguration {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  providerType           SsoProviderType @map("provider_type")
  name                   String
  enabled                Boolean         @default(false)
  issuer                 String?
  clientId               String?         @map("client_id")
  clientSecretEncrypted  String?         @map("client_secret_encrypted")
  authorizationUrl       String?         @map("authorization_url")
  tokenUrl               String?         @map("token_url")
  jwksUrl                String?         @map("jwks_url")
  scopes                 String?
  entityId               String?         @map("entity_id")
  acsUrl                 String?         @map("acs_url")
  metadataUrl            String?         @map("metadata_url")
  certificate            String?
  /// Mock / provider-specific extras (B008 interfaces; real IdP wiring later).
  configJson             Json?           @map("config_json")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerType, name])
  @@index([organizationId])
  @@map("sso_configurations")
}

model ScimConfiguration {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @map("organization_id") @db.Uuid
  enabled         Boolean      @default(false)
  bearerTokenHash String?      @map("bearer_token_hash")
  baseUrl         String?      @map("base_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("scim_configurations")
}

model ScimGroup {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  externalId     String       @map("external_id")
  displayName    String       @map("display_name")
  /// Maps SCIM group → AppRole for provisioning.
  mappedRole     AppRole?     @map("mapped_role")
  memberExternalIds String[]  @default([]) @map("member_external_ids")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@map("scim_groups")
}

model ScimSyncRun {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  status           ScimSyncState @default(IDLE)
  usersCreated     Int           @default(0) @map("users_created")
  usersUpdated     Int           @default(0) @map("users_updated")
  usersDeactivated Int           @default(0) @map("users_deactivated")
  groupsSynced     Int           @default(0) @map("groups_synced")
  errorMessage     String?       @map("error_message")
  startedAt        DateTime      @default(now()) @map("started_at")
  finishedAt       DateTime?     @map("finished_at")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("scim_sync_runs")
}

/// Minimal team entity for team-scoped permission grants (B010). Full org structure lands in B011.
model Team {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    TeamMembership[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("teams")
}

model TeamMembership {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model PermissionGrant {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  permissionId   String           @map("permission_id") @db.Uuid
  scope          PermissionScope
  /// Team id when scope=TEAM; resource id when scope=RESOURCE; null for ORGANIZATION.
  scopeId        String?          @map("scope_id") @db.Uuid
  resourceType   String?          @map("resource_type")
  userId         String?          @map("user_id") @db.Uuid
  roleKey        AppRole?         @map("role_key")
  effect         PermissionEffect @default(ALLOW)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permission     Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([scope, scopeId])
  @@map("permission_grants")
}

// ─── Milestone B3 domain models ──────────────────────────────────────────────

model Policy {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  title          String
  description    String?
  status         PolicyLifecycleStatus @default(DRAFT)
  ownerName      String?               @map("owner_name")
  category       String?
  tags           String[]              @default([])
  version        Int                   @default(1)
  deletedAt      DateTime?             @map("deleted_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       PolicyVersion[]

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([organizationId, updatedAt])
  @@map("policies")
}

model PolicyVersion {
  id          String   @id @default(uuid()) @db.Uuid
  policyId    String   @map("policy_id") @db.Uuid
  version     Int
  title       String
  content     String
  changeNotes String?  @map("change_notes")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
  @@map("policy_versions")
}

model KnowledgeDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  summary        String?
  body           String?
  collection     String?
  status         String       @default("active")
  tags           String[]     @default([])
  version        Int          @default(1)
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, collection])
  @@index([organizationId, deletedAt])
  @@map("documents")
}

model Case {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  title          String
  summary        String?
  status         CaseLifecycleStatus @default(OPEN)
  priority       String              @default("medium")
  ownerId        String?             @map("owner_id") @db.Uuid
  tags           String[]            @default([])
  version        Int                 @default(1)
  deletedAt      DateTime?           @map("deleted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?               @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks          Task[]
  notifications  Notification[]

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([ownerId])
  @@map("cases")
}

model Task {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  caseId         String?             @map("case_id") @db.Uuid
  title          String
  description    String?
  status         TaskLifecycleStatus @default(TODO)
  priority       String              @default("medium")
  assigneeId     String?             @map("assignee_id") @db.Uuid
  createdById    String?             @map("created_by_id") @db.Uuid
  dueAt          DateTime?           @map("due_at")
  tags           String[]            @default([])
  version        Int                 @default(1)
  deletedAt      DateTime?           @map("deleted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case           Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignee       User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([caseId])
  @@index([assigneeId])
  @@index([dueAt])
  @@map("tasks")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  kind           NotificationKind    @default(SYSTEM)
  channel        NotificationChannel @default(IN_APP)
  title          String
  body           String
  href           String?
  groupLabel     String?             @map("group_label")
  caseId         String?             @map("case_id") @db.Uuid
  taskId         String?             @map("task_id") @db.Uuid
  metadata       Json?
  readAt         DateTime?           @map("read_at")
  archivedAt     DateTime?           @map("archived_at")
  deletedAt      DateTime?           @map("deleted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  case           Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  task           Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, readAt])
  @@index([userId, archivedAt, createdAt])
  @@index([organizationId, kind])
  @@map("notifications")
}

model NotificationPreference {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  inAppEnabled   Boolean      @default(true) @map("in_app_enabled")
  emailEnabled   Boolean      @default(true) @map("email_enabled")
  digestEnabled  Boolean      @default(false) @map("digest_enabled")
  digestHourUtc  Int          @default(8) @map("digest_hour_utc")
  kindsMuted     String[]     @default([]) @map("kinds_muted")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("notification_preferences")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  description    String?
  reportType     String       @map("report_type")
  status         ReportStatus @default(DRAFT)
