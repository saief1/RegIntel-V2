NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://regintel:regintel@localhost:5432/regintel?schema=public
DIRECT_URL=postgresql://regintel:regintel@localhost:5432/regintel?schema=public
REDIS_URL=redis://localhost:6379
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
USE_REAL_POLICIES=false
USE_REAL_TASKS=false
USE_REAL_CASES=false
USE_REAL_KNOWLEDGE=false
USE_REAL_REPORTS=false
USE_REAL_NOTIFICATIONS=false
USE_REAL_STORAGE=false
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=refresh_token
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false
LOG_LEVEL=info
ALLOW_REGISTER=true
SEED_ADMIN_EMAIL=admin@regintel.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME="RegIntel Admin"
SEED_ORG_NAME="RegIntel Demo"
SEED_ORG_SLUG=regintel-demo
SESSION_IDLE_TIMEOUT=30m
MFA_TRUSTED_DEVICE_TTL=30d
MFA_TRUSTED_DEVICE_COOKIE_NAME=mfa_trusted_device
PASSWORD_HISTORY_LIMIT=5
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MINUTES=15

