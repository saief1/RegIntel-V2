  contentVersion Int                 @default(1) @map("content_version")
  sourceVersion  String?             @map("source_version")
  metadata       Json?
  chunkCount     Int                 @default(0) @map("chunk_count")
  indexedAt      DateTime            @default(now()) @map("indexed_at")
